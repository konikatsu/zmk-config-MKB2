// Port of C:/Users/noran/qmk_firmware/keyboards/ergodox_ez/keymaps/niko/keymap.c
// to the MeKaBu 46-key layout.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <layout_shift_kp_override.dtsi>

#define DEF 0
#define FUNC 1
#define NUM 2
#define MOUSE 3
#define SCROLL 4
#define BT 5

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        // Match the ErgoDox LT1MU behavior:
        // tap = Muhenkan, hold = FUNC, interrupted press = hold immediately.
        lt_mu: layer_tap_muhenkan {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <170>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
//  Tab    Q      W      E      R      T          Y      U      I      O      P      @/[ key
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT
//  Ctrl   A      S      D      F      G          H      J      K      L      ;      '/Mouse
&kp LCTL   &kp A  &kp S  &kp D  &kp F  &kp G     &kp H  &kp J  &kp K  &kp L  &kp SEMI  &lt MOUSE SQT
//  Shift  Z      X      C      V      B          N      M      ,      .      /      Ro
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B     &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp INT1
//  Esc/BT GUI    Alt           Space/Num  Muhenkan/Fn   Henkan/Num  Enter          RShift RShift RCtrl
&lt BT ESC  &kp LGUI  &kp LALT  &lt NUM SPACE  &lt_mu FUNC INT5     &lt NUM INT4  &kp ENTER  &kp RSHFT  &kp RSHFT  &kp RCTL
//  Optional module key positions (kept from the MeKaBu defaults)
&kp LEFT   &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT     &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                              &kp A                                      &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        function_layer {
            label = "FnNav";
            bindings = <
//  F11    F1     F2     F3     F4     F5         F6     F7     F8     F9     F10    F12
&kp F11    &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
//         Home   Enter  Del    Up     PgDn       Bksp   Left   Down   Right  Minus  End
&trans     &kp HOME  &kp ENTER  &kp DEL  &kp UP  &kp PG_DN     &kp BKSP  &kp LEFT  &kp DOWN  &kp RIGHT  &kp MINUS  &kp END
//         Grave  Bksp   Shift+2 Shift+6 Shift+7  PgUp   PgDn   ]      Backslash  ?   Yen
&trans     &kp GRAVE  &kp BKSP  &kp LS(N2)  &kp LS(N6)  &kp LS(N7)     &kp PG_UP  &kp PG_DN  &kp RBKT  &kp BSLH  &kp LS(FSLH)  &kp INT3
&trans     &trans  &trans       &trans  &trans     &trans  &trans      &trans  &trans  &trans
&kp LEFT   &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT     &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                              &kp A                                      &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            label = "Num";
            bindings = <
//           1       2       3       4       5          6       7       8       9       0
&trans       &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans       &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &kp C_PLAY_PAUSE
&trans       &trans  &trans  &trans  &trans  &trans     &kp EQUAL  &kp PLUS  &trans  &trans  &trans  &trans
&trans       &trans  &trans          &trans  &trans     &kp N0  &kp DOT       &trans  &trans  &trans
&kp LEFT     &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT     &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                  &kp A                                      &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans     &trans  &trans    &trans    &trans    &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans     &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans     &trans  &trans    &trans    &trans    &trans  &trans
&trans    &trans  &trans          &trans  &trans     &trans  &trans              &trans  &trans  &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT     &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                              &kp A                                      &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll_layer {
            label = "Scr";
            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans     &trans  &trans    &trans    &trans    &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans     &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans     &trans  &trans    &trans    &trans    &trans  &trans
&trans    &trans  &trans          &trans  &trans     &trans  &trans              &trans  &trans  &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT     &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                              &kp A                                      &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4     &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans           &trans          &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans           &trans          &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans                      &trans        &trans           &trans          &trans          &trans  &trans  &trans
&kp LEFT    &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                     &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                        &kp A                                                 &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
